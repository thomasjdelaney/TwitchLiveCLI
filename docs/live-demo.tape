# Short preview of the interactive live screen.
# Run after signing in once with the installed CLI.
Output docs/images/live-demo.gif

Set FontSize 18
Set Width 1100
Set Height 650

Type "twitch-live-cli --display card"
Sleep 1.5s
Enter
Sleep 1s
Down
Sleep 1s
Down
Sleep 0.75s
Down
Sleep 1s
Up
Sleep 2s
Type "q"
Sleep 0.5s

Type "twitch-live-cli --display table"
Sleep 1.5s
Enter
Sleep 1s
Down
Sleep 1s
Down
Sleep 0.5s
Down
Sleep 0.75s
Up
Sleep 2s
Type "n"
Sleep 1s
Type "/"
Sleep 0.25s
Type "O"
Sleep 0.75s
Type "wl"
Sleep 1.5s
Backspace
Backspace
Backspace
Sleep 0.5s
Type "Gil"
Sleep 0.75s
Enter
Sleep 0.25s
Enter
Sleep 1s
Escape
Sleep 1s
Type "r"
Sleep 3s
Escape
Sleep 1s
